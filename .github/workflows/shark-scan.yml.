name: Shark & Wyckoff Scanner

on:
  workflow_dispatch:
    inputs:
      mode:
        description: "Chọn scan để quét, telegram_test để chỉ test Telegram"
        required: true
        default: scan
        type: choice
        options:
          - scan
          - telegram_test
  schedule:
    # GitHub cron dùng UTC. 08:35 UTC = 15:35 Việt Nam (UTC+7), Thứ 2–Thứ 6.
    - cron: "35 8 * * 1-5"

permissions:
  contents: read

concurrency:
  group: shark-wyckoff-scan
  cancel-in-progress: false

jobs:
  scan:
    runs-on: ubuntu-latest
    timeout-minutes: 90
    env:
      TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
      TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
      MAX_WORKERS: "5"
      REQUEST_TIMEOUT: "15"
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"
          cache: pip

      - name: Install dependencies
        run: python -m pip install -r requirements.txt

      - name: Test Telegram only
        if: ${{ github.event_name == 'workflow_dispatch' && inputs.mode == 'telegram_test' }}
        run: python bot.py --telegram-test

      - name: Scan all symbols
        if: ${{ github.event_name == 'schedule' || (github.event_name == 'workflow_dispatch' && inputs.mode == 'scan') }}
        run: python bot.py

      - name: Upload scan report
        if: ${{ always() && hashFiles('scan_report.txt') != '' }}
        uses: actions/upload-artifact@v4
        with:
          name: scan-report-${{ github.run_number }}
          path: scan_report.txt
          retention-days: 14
